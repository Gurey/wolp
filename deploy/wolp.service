[Unit]
Description=wolp: forwards to hosts, waking them with Wake-on-LAN
After=network-online.target
Wants=network-online.target

[Service]
User=wolp
ExecStart=/usr/local/bin/wolp -config /etc/wolp/wolp.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
